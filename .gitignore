# ============================================================
# Rayquaza — .gitignore
# ============================================================

# --- SECURITY: Never commit secrets ---
.env
.env.*
*.key
*.pem
*.secret
secrets/
api_keys.txt

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
venv/
env/
.venv/
ENV/
pip-log.txt
pip-delete-this-directory.txt
*.egg-info/
dist/
build/
*.egg
.mypy_cache/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# --- C / C++ builds (liboqs, harness) ---
*.o
*.a
*.so
*.so.*
*.dylib
*.dll
*.exe
build/
_build/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
Makefile
*.cmake
!CMakeLists.txt
# Keep handwritten Makefiles in source directories
!track-a-target/harness/Makefile
!track-a-target/targets/kyber512_leak2/Makefile
!track-a-target/targets/kyber512_leak4/Makefile
!track-a-target/targets/kyber512_leak5/Makefile
!track-a-target/targets/mldsa44_leak1/Makefile

# --- liboqs build artifacts ---
liboqs/
liboqs-build/
install/

# --- AFL++ output ---
afl-out/
afl_output/
findings/
fuzzer-output/

# --- Track B shared dirs (exceptions — these must be tracked) ---
!shared/findings/
!shared/findings/**
!shared/vectors/
!shared/vectors/**
!shared/feedback/
!shared/feedback/**
crashes/
hangs/
queue/
.cur_input

# --- Timing / results data (keep samples, not bulk dumps) ---
track-a-target/results/*.csv
track-a-target/results/*.bin
track-a-target/results/*.raw
shared/benchmark/*.csv
shared/benchmark/*.bin
shared/analysis/*.csv
# To commit a sample: git add -f path/to/sample.csv

# --- IDE / editor ---
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
*.iml

# --- OS files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Logs ---
*.log
logs/
track-a-target/targets/*/harness_oracle
track-a-target/targets/*/harness_leak*

# --- kyber512_leak5 ref files (copied by setup.sh from liboqs, not ours to track) ---
track-a-target/targets/kyber512_leak5/api.h
track-a-target/targets/kyber512_leak5/cbd.c
track-a-target/targets/kyber512_leak5/cbd.h
track-a-target/targets/kyber512_leak5/indcpa.c
track-a-target/targets/kyber512_leak5/indcpa.h
track-a-target/targets/kyber512_leak5/kem.h
track-a-target/targets/kyber512_leak5/ntt.c
track-a-target/targets/kyber512_leak5/ntt.h
track-a-target/targets/kyber512_leak5/params.h
track-a-target/targets/kyber512_leak5/poly.c
track-a-target/targets/kyber512_leak5/poly.h
track-a-target/targets/kyber512_leak5/polyvec.c
track-a-target/targets/kyber512_leak5/polyvec.h
track-a-target/targets/kyber512_leak5/reduce.c
track-a-target/targets/kyber512_leak5/reduce.h
track-a-target/targets/kyber512_leak5/symmetric-shake.c
track-a-target/targets/kyber512_leak5/symmetric.h
track-a-target/targets/kyber512_leak5/verify.c
track-a-target/targets/kyber512_leak5/verify.h

# --- stale/early timing feedback files ---
shared/feedback/timing_LEAK5-001_*.json
